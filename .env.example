# Copy to .env and adjust. docker compose picks these up automatically.

# ---------------------------------------------------------------------------
# AI provider. Pick ONE block, or none at all: with no key the AI features
# answer from the built-in query library and say so in the UI.
# ---------------------------------------------------------------------------

# Option A - Anthropic (paid)
ANTHROPIC_API_KEY=
SHOPPULSE_AI_MODEL=claude-sonnet-5-5

# Option B - Groq, free tier, no card. console.groq.com/keys
# AI_PROVIDER=openai
# OPENAI_API_KEY=gsk_...
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=openai/gpt-oss-120b

# Option C - Google Gemini free tier via its OpenAI-compatible layer. aistudio.google.com/apikey
# AI_PROVIDER=openai
# OPENAI_API_KEY=AIza...
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# OPENAI_MODEL=gemini-2.5-flash

# Option D - OpenRouter free models (IDs ending in :free). openrouter.ai/keys
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-or-...
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=google/gemma-3-27b-it:free

# Option E - fully local with Ollama: no key, no quota, no data leaving the machine
# AI_PROVIDER=openai
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=llama3.1:8b

# Override in any non-local environment. Must be at least 32 bytes.
JWT_SECRET=change-me-in-production-shoppulse-dev-secret-key-32b

# Demo data generator
SEED_ENABLED=true
SEED_MONTHS=6
SEED_CUSTOMERS=2500
