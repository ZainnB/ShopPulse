# Copy to .env and adjust. docker compose picks these up automatically.

# Enables live AI features. Leave unset for the deterministic fallback mode.
ANTHROPIC_API_KEY=

# Chat model used by "ask your store", the weekly briefing and anomaly explanations.
SHOPPULSE_AI_MODEL=claude-sonnet-5-5

# Override in any non-local environment. Must be at least 32 bytes.
JWT_SECRET=change-me-in-production-shoppulse-dev-secret-key-32b

# Demo data generator
SEED_ENABLED=true
SEED_MONTHS=6
SEED_CUSTOMERS=2500
